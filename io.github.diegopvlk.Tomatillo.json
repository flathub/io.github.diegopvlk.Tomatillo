{
	"id": "io.github.diegopvlk.Tomatillo",
	"runtime": "org.gnome.Platform",
	"runtime-version": "50",
	"sdk": "org.gnome.Sdk",
	"command": "tomatillo",
	"finish-args": [
		"--share=ipc",
		"--socket=fallback-x11",
		"--device=dri",
		"--socket=wayland",
		"--socket=pulseaudio"
	],
	"cleanup": [
		"/include",
		"/lib/pkgconfig",
		"/share/gir-1.0"
	],
	"modules": [
		{
			"name": "libportal",
			"buildsystem": "meson",
			"config-opts": ["-Ddocs=false", "-Dvapi=false"],
			"sources": [
				{
					"type": "git",
					"url": "https://github.com/flatpak/libportal",
					"tag": "0.10.0",
					"commit": "c23024018c8eb076549a1517fcb2d7f80d3e2ed5"
				}
			]
		},
		{
			"name": "tomatillo",
			"builddir": true,
			"buildsystem": "meson",
			"sources": [
				{
					"type": "git",
					"url": "https://github.com/diegopvlk/Tomatillo",
					"tag": "v1.1.1",
					"commit": "ef102d4e8f9db871a57dbadab79250837682ed28"
				}
			]
		}
	]
}
